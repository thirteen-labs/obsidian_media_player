{
  "name": "obsidian-media-player",
  "version": "0.5.0",
  "description": "Plug-and-play media toolkit for React Native: Video, Audio, and a full-featured Music player with playlists, background playback, lock-screen controls, HLS/DASH streaming and caching.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "plugin",
    "react-native.config.js",
    "progress.md",
    "to-be-done.md",
    "!.idea",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./plugin": "./plugin/index.js",
    "./react-native.config.js": "./react-native.config.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "prepare": "bob build",
    "prepack": "bob build",
    "codegen": "react-native codegen --platform ios --project-root ./example/ios || true",
    "verify:android": "node scripts/verify-android-kotlin.mjs",
    "verify:android:host": "node scripts/ci/verify-android-host.mjs",
    "verify:ios": "node scripts/verify-ios-codegen.mjs",
    "verify:ios:pod": "node scripts/ci/verify-ios-pod.mjs",
    "verify:ios:all": "npm run verify:ios && npm run verify:ios:pod",
    "verify:gates": "node scripts/ci/gate-self-test.mjs",
    "test": "jest",
    "bundle:web": "node scripts/bundle-web.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run bundle:web && npm run verify:ios"
  },
  "keywords": [
    "react-native",
    "video",
    "audio",
    "music",
    "player",
    "media",
    "hls",
    "dash",
    "playlist",
    "background-audio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thirteen-labs/obsidian_media_player.git"
  },
  "license": "MIT",
  "author": "Thirteen Labs",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.87.1",
    "react-native-builder-bob": "^0.30.0",
    "react-native-web": "^0.21.3",
    "react-test-renderer": "^19.2.3",
    "typescript": "^5.3.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "codegenConfig": {
    "name": "ObsidianMediaPlayerSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.obsidianmediaplayer"
    }
  }
}
